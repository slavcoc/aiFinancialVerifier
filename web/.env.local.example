# Auth (required)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Verification engine (the Express API in the repo root)
API_URL=http://localhost:8787

# Social login — Google (optional; leave unset to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Show the Google button only when credentials are set:
NEXT_PUBLIC_GOOGLE_ENABLED=0
