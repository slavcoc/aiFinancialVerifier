# Google Gemini (or set MODEL=claude-... and use Anthropic instead)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MODEL=gemini-3.8-flash    # e.g. MODEL=claude-haiku-5-5 → Anthropic provider

# Pipeline
VALIDITY_PASS=on        # "off" skips the relation-validity pass (lower cost, higher false-positive risk)
GEMINI_MOCK=0           # 1 = canned extraction, no API key needed (pipeline testing)
PORT=8787
MAX_INPUT_CHARS=100000
